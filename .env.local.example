# Copy this file to .env.local and fill in the values from your Supabase
# project (Project Settings → API, and Settings → Database).
# See the setup checklist for exactly where each value comes from.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Prisma: pooled connection for the running app, direct connection for
# anything that needs a non-pooled session (kept for parity — this project
# runs its schema via the SQL editor, not `prisma migrate`).
DATABASE_URL=
DIRECT_URL=
